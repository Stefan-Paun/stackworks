// Arguments 5 and later travel on the stack.
fn summe6(a, b, c, d, e, f) {
    return a + 2 * b + 3 * c + 4 * d + 5 * e + 6 * f;
}

fn waehle(a, b, c, d, e, f, g) {
    return e * 100 + f * 10 + g;
}

fn main() {
    print(summe6(1, 1, 1, 1, 1, 1));
    print(summe6(1, 2, 3, 4, 5, 6));
    print(waehle(1, 2, 3, 4, 5, 6, 7));
    print(summe6(1, 0, 0, 0, 0, waehle(0, 0, 0, 0, 1, 2, 3)));
}
